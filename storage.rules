rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // fotos e audios do chat -- qualquer logado le/escreve, com limite de
    // tamanho (32MB, mesmo teto usado nas fotos de anuncio)
    match /chats/{imovelId}/midia/{arquivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 32 * 1024 * 1024;
    }
  }
}
